  deviceId             String    @map("device_id") @db.Uuid
  endpointHash         String    @unique(map: "push_subscriptions_endpoint_hash_key") @map("endpoint_hash") @db.Char(64)
  sealedPayload        Bytes     @map("sealed_payload")
  payloadNonce         Bytes     @map("payload_nonce")
  encryptionKeyVersion Int       @map("encryption_key_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSuccessAt        DateTime? @map("last_success_at") @db.Timestamptz(6)
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, disabledAt], map: "push_subscriptions_device_disabled_idx")
  @@map("push_subscriptions")
}

model InAppNotification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  messageId       String?          @map("message_id") @db.Uuid
  type            NotificationType
  relatedEntityId String?          @map("related_entity_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime?        @map("read_at") @db.Timestamptz(6)
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt], map: "in_app_notifications_user_unread_idx")
  @@index([expiresAt], map: "in_app_notifications_expires_at_idx")
  @@map("in_app_notifications")
}

model AdminAuditEvent {
  id           String               @id @default(uuid()) @db.Uuid
  actorAdminId String               @map("actor_admin_id") @db.Uuid
  action       AdminAuditAction
  targetType   AdminAuditTargetType @map("target_type")
  targetId     String?              @map("target_id") @db.Uuid
  targetUserId String?              @map("target_user_id") @db.Uuid
  reasonCode   String?              @map("reason_code") @db.VarChar(1000)
  stateBefore  String?              @map("state_before") @db.VarChar(1000)
  stateAfter   String?              @map("state_after") @db.VarChar(1000)
  requestId    String               @map("request_id") @db.Uuid
  ipHash       String?              @map("ip_hash") @db.Char(64)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  actor      User  @relation("AuditActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorAdminId, createdAt], map: "admin_audit_events_actor_created_idx")
  @@index([targetType, targetId, createdAt], map: "admin_audit_events_target_created_idx")
  @@index([targetUserId, createdAt], map: "admin_audit_events_target_user_idx")
  @@map("admin_audit_events")
}
