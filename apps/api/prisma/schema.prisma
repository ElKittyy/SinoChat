  client        ClientProfile @relation(fields: [clientUserId], references: [userId], onDelete: Restrict)
  assignedAdmin User?         @relation("AccountReviewAssignedTo", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  closedByAdmin User?         @relation("AccountReviewClosedBy", fields: [closedByAdminUserId], references: [id], onDelete: SetNull)

