  @@index([grantExpiresAt], map: "pending_report_evidence_uploads_expires_idx")
  @@index([clientUserId, assignmentId], map: "pending_report_evidence_uploads_owner_assignment_idx")
  @@map("pending_report_evidence_uploads")
}

model AccountReview {
  id                  String                @id @default(uuid()) @db.Uuid
  clientUserId        String                @map("client_user_id") @db.Uuid
  reason              AccountReviewReason
  status              AccountReviewStatus   @default(OPEN)
  assignedAdminUserId String?               @map("assigned_admin_user_id") @db.Uuid
  closedByAdminUserId String?               @map("closed_by_admin_user_id") @db.Uuid
  outcome             AccountReviewOutcome?
  resolutionSummary   String?               @map("resolution_summary") @db.VarChar(2000)
  openedAt            DateTime              @default(now()) @map("opened_at") @db.Timestamptz(6)
  reviewStartedAt     DateTime?             @map("review_started_at") @db.Timestamptz(6)
