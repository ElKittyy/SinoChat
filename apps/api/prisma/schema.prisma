generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  CASHIER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum CashierApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum AssignmentStartReason {
  INVITATION
  CLIENT_BLOCKED_CASHIER
  CLIENT_REPORTED_CASHIER
  CASHIER_BLOCKED_CLIENT
  CASHIER_UNAVAILABLE
  ADMINISTRATIVE
}

enum AssignmentEndReason {
  CLIENT_BLOCKED_CASHIER
  CLIENT_REPORTED_CASHIER
  CASHIER_BLOCKED_CLIENT
  CASHIER_UNAVAILABLE
  CLIENT_SUSPENDED
  CASHIER_SUSPENDED
  ACCOUNT_DELETED
  ADMINISTRATIVE
}

enum ReassignmentReason {
  CLIENT_BLOCKED_CASHIER
  CLIENT_REPORTED_CASHIER
  CASHIER_BLOCKED_CLIENT
  CASHIER_UNAVAILABLE
  ADMINISTRATIVE
}

enum ReassignmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum RecoveryBundleProtection {
  RECOVERY_CODE
  TRUSTED_DEVICE
}

enum MessageKind {
  TEXT
  IMAGE
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

enum AttachmentUploadStatus {
  PENDING
  AVAILABLE
  PURGE_PENDING
  PURGE_FAILED
}

enum BlockInitiator {
  CLIENT
  CASHIER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  CLOSING
  CLOSED
}

enum ReportOutcome {
  NO_ACTION
  WARNING
  CASHIER_SUSPENDED
  CASHIER_DELETED
  OTHER
}

enum AccountReviewReason {
  FIVE_DISTINCT_CASHIER_BLOCKS
  ADMINISTRATIVE
}

enum AccountReviewStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum AccountReviewOutcome {
  REACTIVATED
  REMAINS_SUSPENDED
  ACCOUNT_DELETED
  OTHER
}

enum AdminWebAuthnChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum NotificationType {
  NEW_MESSAGE
  MESSAGE_DELIVERED
  MESSAGE_READ
  ASSIGNMENT_CHANGED
  ACCOUNT_STATUS_CHANGED
  REPORT_RESOLVED
  REPORT_WARNING
}

enum AdminAuditAction {
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DELETED
  PASSWORD_RESET
  CASHIER_APPROVED
  CASHIER_REJECTED
  CASHIER_APPROVAL_REVOKED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_DEACTIVATED
  CLIENT_REASSIGNED
  REPORT_OPENED
  REPORT_REVIEW_STARTED
  REPORT_EVIDENCE_ACCESSED
  REPORT_CLOSED
  ACCOUNT_REVIEW_OPENED
  ACCOUNT_REVIEW_CLOSED
  CASHIER_ONBOARDING_INVITATION_CREATED
  CASHIER_ONBOARDING_INVITATION_REVOKED
  INVITATION_REVOKED
  ADMIN_SESSION_REVOKED
  ADMIN_OTHER_SESSIONS_REVOKED
  ADMIN_PASSKEY_REGISTERED
  ADMIN_PASSKEY_REVOKED
  ADMIN_MFA_RECOVERED
}

enum AdminAuditTargetType {
  USER
  CASHIER_PROFILE
  SUBSCRIPTION
  ASSIGNMENT
  REPORT
  ACCOUNT_REVIEW
  CASHIER_ONBOARDING_INVITATION
  INVITATION
  AUTH_SESSION
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  role                  UserRole
  username              String        @db.VarChar(50)
  normalizedUsername    String        @unique(map: "users_normalized_username_key") @map("normalized_username") @db.VarChar(50)
  passwordHash          String        @map("password_hash") @db.VarChar(255)
  passwordChangedAt     DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  passwordResetRequired Boolean       @default(false) @map("password_reset_required")
  sessionVersion        Int           @default(1) @map("session_version")
  status                AccountStatus @default(PENDING)
  failedLoginAttempts   Int           @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?     @map("locked_until") @db.Timestamptz(6)
  lastLoginAt           DateTime?     @map("last_login_at") @db.Timestamptz(6)
  suspendedAt           DateTime?     @map("suspended_at") @db.Timestamptz(6)
  suspensionReasonCode  String?       @map("suspension_reason_code") @db.VarChar(64)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  adminWebAuthnUserHandle Bytes?       @unique(map: "users_admin_webauthn_user_handle_key") @map("admin_webauthn_user_handle")

  clientProfile                  ClientProfile?
  cashierProfile                 CashierProfile?
  sessions                       AuthSession[]
  devices                        Device[]
  encryptedKeyBundles            EncryptedKeyBundle[]
  termsAcceptances               TermsAcceptance[]
  cashierApprovals               CashierProfile[]              @relation("CashierApprovedBy")
  managedSubscriptions           CashierSubscription[]         @relation("SubscriptionManagedBy")
  cashierOnboardingInvites       CashierOnboardingInvitation[] @relation("CashierOnboardingInvitationCreatedBy")
  administrativeAssignments      Assignment[]                  @relation("AssignmentCreatedBy")
  reportsReviewed                Report[]                      @relation("ReportReviewedBy")
  reportClosuresRequested        ReportClosureJob[]            @relation("ReportClosureRequestedBy")
  accountReviewsAssigned         AccountReview[]               @relation("AccountReviewAssignedTo")
  accountReviewsClosed           AccountReview[]               @relation("AccountReviewClosedBy")
  messageReceipts                MessageReceipt[]
  notifications                  InAppNotification[]
  pendingAttachmentUploads       PendingAttachmentUpload[]
  pendingEvidenceUploads         PendingReportEvidenceUpload[]
  auditEventsAuthored            AdminAuditEvent[]             @relation("AuditActor")
  auditEventsTargeting           AdminAuditEvent[]             @relation("AuditTargetUser")
  matrixDeviceListState          MatrixDeviceListState?
  matrixDeviceRegistrations      MatrixDeviceRegistration[]
  matrixListChangesReceived      MatrixDeviceListChange[]      @relation("MatrixListChangeRecipient")
  matrixListChangesSubject       MatrixDeviceListChange[]      @relation("MatrixListChangeSubject")
  cashierPasswordResetsInitiated CashierPasswordReset[]        @relation("CashierPasswordResetInitiatedBy")
  adminWebAuthnCredentials       AdminWebAuthnCredential[]
  adminWebAuthnChallenges        AdminWebAuthnChallenge[]
  adminRecoveryCodes             AdminRecoveryCode[]

  @@index([role, status], map: "users_role_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model ClientProfile {
  userId          String   @id @map("user_id") @db.Uuid
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  declaredAdultAt DateTime @map("declared_adult_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments   Assignment[]
  blocks        Block[]
  reviews       AccountReview[]
  reassignments ReassignmentRequest[]

  @@map("client_profiles")
}

model CashierProfile {
  userId            String                @id @map("user_id") @db.Uuid
  dateOfBirth       DateTime              @map("date_of_birth") @db.Date
  declaredAdultAt   DateTime              @map("declared_adult_at") @db.Timestamptz(6)
  email             String                @db.VarChar(254)
  normalizedEmail   String                @unique(map: "cashier_profiles_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  phoneE164         String                @unique(map: "cashier_profiles_phone_e164_key") @map("phone_e164") @db.VarChar(20)
  emailVerifiedAt   DateTime?             @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?             @map("phone_verified_at") @db.Timestamptz(6)
  approvalStatus    CashierApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(6)
  approvedByAdminId String?               @map("approved_by_admin_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                      User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedByAdmin           User?                        @relation("CashierApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  invitations               CashierInvitation[]
  subscriptions             CashierSubscription[]
  assignments               Assignment[]
  blocks                    Block[]
  excludedFromReassignments ReassignmentRequest[]        @relation("ReassignmentExcludedCashier")
  onboardingInvitation      CashierOnboardingInvitation?
  recoveryCodes             CashierRecoveryCode[]
  passwordResets            CashierPasswordReset[]

  @@index([approvalStatus], map: "cashier_profiles_approval_status_idx")
  @@map("cashier_profiles")
}

model TermsDocument {
  id          String    @id @default(uuid()) @db.Uuid
  version     String    @unique @db.VarChar(32)
  contentHash String    @unique(map: "terms_documents_content_hash_key") @map("content_hash") @db.Char(64)
  contentType String?   @map("content_type") @db.VarChar(32)
  content     Bytes?
  byteSize    Int?      @map("byte_size")
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  acceptances TermsAcceptance[]

  @@map("terms_documents")
}

model TermsAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  termsDocumentId String   @map("terms_document_id") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash          String?  @map("ip_hash") @db.Char(64)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  termsDocument TermsDocument @relation(fields: [termsDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, termsDocumentId], map: "terms_acceptances_user_document_key")
  @@index([termsDocumentId, acceptedAt], map: "terms_acceptances_document_at_idx")
  @@map("terms_acceptances")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  tokenHash        String    @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  csrfSecretHash   String    @map("csrf_secret_hash") @db.Char(64)
  sessionVersion   Int       @map("session_version")
  ipHash           String?   @map("ip_hash") @db.Char(64)
  userAgentHash    String?   @map("user_agent_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(64)
  adminMfaVerifiedAt DateTime? @map("admin_mfa_verified_at") @db.Timestamptz(6)

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device                     Device?                     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  matrixDeviceRegistrations  MatrixDeviceRegistration[]
  matrixToDeviceTransactions MatrixToDeviceTransaction[]
  adminWebAuthnChallenges     AdminWebAuthnChallenge[]
  matrixDeviceCandidates     MatrixDeviceCandidate[]
  matrixVerificationFlowsReviewed MatrixDeviceVerificationFlow[]

  @@index([userId, expiresAt], map: "auth_sessions_user_expires_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model AdminWebAuthnCredential {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  credentialId  String    @unique(map: "admin_webauthn_credentials_credential_key") @map("credential_id") @db.VarChar(1024)
  publicKey     Bytes     @map("public_key")
  counter       BigInt    @default(0)
  transports    String[]  @default([])
  deviceType    String    @map("device_type") @db.VarChar(16)
  backedUp      Boolean   @default(false) @map("backed_up")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, revokedAt], map: "admin_webauthn_credentials_admin_active_idx")
  @@map("admin_webauthn_credentials")
}

model AdminWebAuthnChallenge {
  id          String                         @id @default(uuid()) @db.Uuid
  adminUserId String                         @map("admin_user_id") @db.Uuid
  sessionId   String                         @map("session_id") @db.Uuid
  purpose     AdminWebAuthnChallengePurpose
  challengeHash String                       @unique(map: "admin_webauthn_challenges_hash_key") @map("challenge_hash") @db.Char(64)
  createdAt   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime                       @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?                      @map("consumed_at") @db.Timestamptz(6)

  admin   User        @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([adminUserId, purpose, expiresAt], map: "admin_webauthn_challenges_admin_expiry_idx")
  @@index([expiresAt, consumedAt], map: "admin_webauthn_challenges_expiry_idx")
  @@map("admin_webauthn_challenges")
}

model AdminRecoveryCode {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @unique(map: "admin_recovery_codes_hash_key") @map("code_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, usedAt, revokedAt], map: "admin_recovery_codes_available_idx")
  @@map("admin_recovery_codes")
}

model CashierRecoveryCode {
  id            String    @id @default(uuid()) @db.Uuid
  cashierUserId String    @map("cashier_user_id") @db.Uuid
  codeHash      String    @unique(map: "cashier_recovery_codes_hash_key") @map("code_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  cashier       CashierProfile        @relation(fields: [cashierUserId], references: [userId], onDelete: Restrict)
  passwordReset CashierPasswordReset?

  @@unique([id, cashierUserId], map: "cashier_recovery_codes_id_cashier_key")
  @@index([cashierUserId, usedAt, revokedAt, expiresAt], map: "cashier_recovery_codes_available_idx")
  @@map("cashier_recovery_codes")
}

model CashierPasswordReset {
  id                     String    @id @default(uuid()) @db.Uuid
  cashierUserId          String    @map("cashier_user_id") @db.Uuid
  initiatedByAdminUserId String    @map("initiated_by_admin_user_id") @db.Uuid
  recoveryCodeId         String?   @unique(map: "cashier_password_resets_recovery_code_key") @map("recovery_code_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(6)
  supersededAt           DateTime? @map("superseded_at") @db.Timestamptz(6)

  cashier          CashierProfile       @relation(fields: [cashierUserId], references: [userId], onDelete: Restrict)
  initiatedByAdmin User                 @relation("CashierPasswordResetInitiatedBy", fields: [initiatedByAdminUserId], references: [id], onDelete: Restrict)
  recoveryCode     CashierRecoveryCode? @relation(fields: [recoveryCodeId, cashierUserId], references: [id, cashierUserId], onDelete: Restrict)

  @@unique([recoveryCodeId, cashierUserId], map: "cashier_password_resets_code_cashier_key")
  @@index([cashierUserId, expiresAt], map: "cashier_password_resets_cashier_expires_idx")
  @@index([expiresAt, consumedAt, supersededAt], map: "cashier_password_resets_state_idx")
  @@map("cashier_password_resets")
}

model Device {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @map("user_id") @db.Uuid
  registrationId         Int?         @map("registration_id")
  identityPublicKey      Bytes?       @map("identity_public_key")
  identityKeyFingerprint String?      @unique(map: "devices_identity_fingerprint_key") @map("identity_key_fingerprint") @db.Char(64)
  signedPreKeyId         Int?         @map("signed_pre_key_id")
  signedPreKeyPublic     Bytes?       @map("signed_pre_key_public")
  signedPreKeySignature  Bytes?       @map("signed_pre_key_signature")
  bindingSecretHash      String       @map("binding_secret_hash") @db.Char(64)
  protocolVersion        String       @map("protocol_version") @db.VarChar(32)
  status                 DeviceStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt             DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  revokedAt              DateTime?    @map("revoked_at") @db.Timestamptz(6)

  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions               AuthSession[]
  oneTimePreKeys         OneTimePreKey[]
  sourceRecoveryBundles  EncryptedKeyBundle[]        @relation("RecoveryBundleSourceDevice")
  sentMessages           Message[]                   @relation("MessageSenderDevice")
  messageEnvelopes       MessageEnvelope[]           @relation("EnvelopeRecipientDevice")
  preKeyClaimsRequested  OneTimePreKeyClaim[]        @relation("PreKeyClaimRequesterDevice")
  preKeyClaimsReceived   OneTimePreKeyClaim[]        @relation("PreKeyClaimRecipientDevice")
  pushSubscriptions      PushSubscription[]
  matrixDeviceKey        MatrixDeviceKey?
  matrixOneTimeKeys      MatrixOneTimeKey[]
  matrixFallbackKeys     MatrixFallbackKey[]
  matrixFallbackSlots    MatrixFallbackKeySlot[]
  matrixClaimsRequested  MatrixKeyClaimRequest[]
  matrixClaimsReceived   MatrixKeyClaimResult[]      @relation("MatrixClaimRecipientDevice")
  matrixListChanges      MatrixDeviceListChange[]
  matrixToDeviceCursor   MatrixToDeviceCursor?
  matrixToDeviceSent     MatrixToDeviceTransaction[]
  matrixToDeviceReceived MatrixToDeviceEvent[]       @relation("MatrixToDeviceRecipient")

  @@unique([id, userId], map: "devices_id_user_key")
  @@unique([userId, registrationId], map: "devices_user_registration_key")
  @@index([userId, status], map: "devices_user_status_idx")
  @@map("devices")
}

model OneTimePreKey {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  keyId     Int       @map("key_id")
  publicKey Bytes     @map("public_key")
  signature Bytes?    @map("signature")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)

  device Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  claim  OneTimePreKeyClaim?

  @@unique([deviceId, keyId], map: "one_time_pre_keys_device_key_id_key")
  @@index([deviceId, claimedAt], map: "one_time_pre_keys_available_idx")
  @@map("one_time_pre_keys")
}

model OneTimePreKeyClaim {
  id                String   @id @default(uuid()) @db.Uuid
  requesterDeviceId String   @map("requester_device_id") @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  recipientDeviceId String   @map("recipient_device_id") @db.Uuid
  oneTimePreKeyId   String?  @unique(map: "one_time_pre_key_claims_pre_key_key") @map("one_time_pre_key_id") @db.Uuid
  claimedAt         DateTime @map("claimed_at") @db.Timestamptz(6)

  requesterDevice Device         @relation("PreKeyClaimRequesterDevice", fields: [requesterDeviceId], references: [id], onDelete: Restrict)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  recipientDevice Device         @relation("PreKeyClaimRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: Restrict)
  oneTimePreKey   OneTimePreKey? @relation(fields: [oneTimePreKeyId], references: [id], onDelete: Restrict)

  @@unique([requesterDeviceId, conversationId, recipientDeviceId], map: "one_time_pre_key_claims_request_key")
  @@index([conversationId, claimedAt], map: "one_time_pre_key_claims_conversation_idx")
  @@index([recipientDeviceId, claimedAt], map: "one_time_pre_key_claims_recipient_idx")
  @@map("one_time_pre_key_claims")
}

/// Reserva un UUID de dispositivo antes de inicializar OlmMachine. La
/// finalizacion crea Device + MatrixDeviceKey y consume la reserva en una
/// unica transaccion.
model MatrixDeviceRegistration {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(6)
  initialUploadSha256    String?   @map("initial_upload_sha256") @db.Char(64)
  initialOneTimeKeyCount Int?      @map("initial_one_time_key_count")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "matrix_device_registrations_user_expires_idx")
  @@index([sessionId], map: "matrix_device_registrations_session_idx")
  @@map("matrix_device_registrations")
}

enum MatrixDeviceCandidateStatus {
  PENDING
  CANCELLED
  EXPIRED
}

/// Quarantine only: no Device, key directory, prekeys, cursor or session binding.
/// SQL enforces one pending request per user and irreversible terminal states.
model MatrixDeviceCandidate {
  id                      String @id @db.Uuid
  userId                  String @map("user_id") @db.Uuid
  sessionId               String @map("session_id") @db.Uuid
  sessionVersion          Int @map("session_version")
  matrixUserId            String @map("matrix_user_id") @db.VarChar(289)
  matrixDeviceId          String @unique(map: "matrix_device_candidates_matrix_device_key") @map("matrix_device_id") @db.VarChar(33)
  trustedDeviceId         String @map("trusted_device_id") @db.Uuid
  identityBootstrapSha256 String @map("identity_bootstrap_sha256") @db.Char(64)
  deviceKeys              Json @map("device_keys")
  canonicalSha256         String @map("canonical_sha256") @db.Char(64)
  ed25519Key              String @map("ed25519_key") @db.Char(43)
  curve25519Key           String @map("curve25519_key") @db.Char(43)
  status                  MatrixDeviceCandidateStatus @default(PENDING)
  createdAt               DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt               DateTime @map("expires_at") @db.Timestamptz(6)
  resolvedAt              DateTime? @map("resolved_at") @db.Timestamptz(6)

  session       AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  identity      MatrixCrossSigningIdentity @relation(fields: [userId, matrixUserId], references: [userId, matrixUserId], onDelete: Restrict, onUpdate: Restrict)
  trustedDevice MatrixDeviceKey @relation(fields: [trustedDeviceId, userId], references: [deviceId, userId], onDelete: Restrict, onUpdate: Restrict)
  verificationFlow MatrixDeviceVerificationFlow?

  @@unique([id, userId], map: "matrix_device_candidates_id_user_key")
  @@index([userId, status, expiresAt], map: "matrix_device_candidates_user_pending_idx")
  @@index([sessionId], map: "matrix_device_candidates_session_idx")
  @@map("matrix_device_candidates")
}

enum MatrixDeviceVerificationFlowStatus {
  PENDING
  CANCELLED
  EXPIRED
}

/// Admission of one immutable SAS request in quarantine, not delivery or approval.
/// Both participant sessions and the candidate must remain eligible for use.
model MatrixDeviceVerificationFlow {
  candidateId            String @id @map("candidate_id") @db.Uuid
  userId                 String @map("user_id") @db.Uuid
  flowId                 String @map("flow_id") @db.VarChar(255)
  reviewerSessionId      String @map("reviewer_session_id") @db.Uuid
  reviewerSessionVersion Int @map("reviewer_session_version")
  requestTransactionId   String @map("request_transaction_id") @db.VarChar(255)
  requestContent         Json @map("request_content")
  requestSha256          String @map("request_sha256") @db.Char(64)
  createdAt              DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(6)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  status                 MatrixDeviceVerificationFlowStatus @default(PENDING)

  candidate       MatrixDeviceCandidate @relation(fields: [candidateId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  reviewerSession AuthSession @relation(fields: [reviewerSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([candidateId, userId], map: "matrix_device_verification_flows_candidate_owner_key")
  @@unique([userId, flowId], map: "matrix_device_verification_flows_user_flow_key")
  @@unique([userId, requestTransactionId], map: "matrix_device_verification_flows_user_request_txn_key")
  @@index([reviewerSessionId], map: "matrix_device_verification_flows_reviewer_session_idx")
  @@index([userId, status, expiresAt], map: "matrix_device_verification_flows_user_pending_idx")
  @@map("matrix_device_verification_flows")
}

model MatrixDeviceListState {
  userId       String   @id @map("user_id") @db.Uuid
  matrixUserId String   @unique(map: "matrix_device_list_states_matrix_user_key") @map("matrix_user_id") @db.VarChar(289)
  version      BigInt   @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceKeys MatrixDeviceKey[]
  crossSigningIdentity MatrixCrossSigningIdentity?

  @@unique([userId, matrixUserId], map: "matrix_device_list_states_user_matrix_key")
  @@map("matrix_device_list_states")
}

model MatrixDeviceKey {
  deviceId        String   @id @map("device_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  matrixUserId    String   @map("matrix_user_id") @db.VarChar(289)
  matrixDeviceId  String   @unique(map: "matrix_device_keys_matrix_device_key") @map("matrix_device_id") @db.VarChar(33)
  curve25519Key   String   @unique(map: "matrix_device_keys_curve25519_key") @map("curve25519_key") @db.Char(43)
  ed25519Key      String   @unique(map: "matrix_device_keys_ed25519_key") @map("ed25519_key") @db.Char(43)
  deviceKeys      Json     @map("device_keys")
  canonicalSha256 String   @map("canonical_sha256") @db.Char(64)
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  device    Device                @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict)
  listState MatrixDeviceListState @relation(fields: [userId, matrixUserId], references: [userId, matrixUserId], onDelete: Restrict)
  bootstrapIdentity MatrixCrossSigningIdentity? @relation("MatrixCrossSigningBootstrapDevice")
  crossSigningCertificate MatrixDeviceCrossSigning?
  candidateRequests MatrixDeviceCandidate[]

  @@unique([deviceId, userId], map: "matrix_device_keys_device_user_key")
  @@unique([matrixUserId, matrixDeviceId], map: "matrix_device_keys_user_device_key")
  @@index([userId, uploadedAt], map: "matrix_device_keys_user_uploaded_idx")
  @@map("matrix_device_keys")
}

/// Public-only, immutable initial cross-signing identity. The initial device
/// certificate is required at transaction commit by a deferred SQL foreign key.
/// No reset/rotation, private keys, or additional-device approval is represented.
model MatrixCrossSigningIdentity {
  userId            String   @id @map("user_id") @db.Uuid
  matrixUserId      String   @unique(map: "matrix_cross_signing_identities_matrix_user_key") @map("matrix_user_id") @db.VarChar(289)
  bootstrapDeviceId String   @unique(map: "matrix_cross_signing_identities_bootstrap_device_key") @map("bootstrap_device_id") @db.Uuid
  masterKey         String   @map("master_key") @db.Char(43)
  selfSigningKey    String   @map("self_signing_key") @db.Char(43)
  userSigningKey    String   @map("user_signing_key") @db.Char(43)
  signingKeys       Json     @map("signing_keys")
  bootstrapSha256   String   @map("bootstrap_sha256") @db.Char(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listState MatrixDeviceListState @relation(fields: [userId, matrixUserId], references: [userId, matrixUserId], onDelete: Restrict, map: "matrix_cross_signing_identities_list_state_fkey")
  bootstrapDevice MatrixDeviceKey @relation("MatrixCrossSigningBootstrapDevice", fields: [bootstrapDeviceId, userId], references: [deviceId, userId], onDelete: Restrict, map: "matrix_cross_signing_identities_bootstrap_device_fkey")
  bootstrapCertificate MatrixDeviceCrossSigning @relation("MatrixCrossSigningBootstrapCertificate", fields: [bootstrapDeviceId, userId], references: [deviceId, userId], onDelete: Restrict, onUpdate: Restrict, map: "matrix_cross_signing_identities_bootstrap_certificate_fkey")
  certificates MatrixDeviceCrossSigning[] @relation("MatrixCrossSigningDeviceCertificates")
  candidateRequests MatrixDeviceCandidate[]

  @@unique([bootstrapDeviceId, userId], map: "matrix_cross_signing_identities_bootstrap_owner_key")
  @@unique([userId, matrixUserId], map: "matrix_cross_signing_identities_user_matrix_key")
  @@map("matrix_cross_signing_identities")
}

/// Immutable certified copy, separate from MatrixDeviceKey.deviceKeys so the
/// original self-signed registration object remains untouched and replayable.
/// SQL currently admits only the initial bootstrap device, not a second device.
model MatrixDeviceCrossSigning {
  deviceId         String   @id @map("device_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  signedDeviceKeys  Json     @map("signed_device_keys")
  canonicalSha256   String   @map("canonical_sha256") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deviceKeys MatrixDeviceKey @relation(fields: [deviceId, userId], references: [deviceId, userId], onDelete: Restrict, map: "matrix_device_cross_signings_device_owner_fkey")
  identity MatrixCrossSigningIdentity @relation("MatrixCrossSigningDeviceCertificates", fields: [userId], references: [userId], onDelete: Restrict, map: "matrix_device_cross_signings_identity_fkey")
  bootstrappedIdentity MatrixCrossSigningIdentity? @relation("MatrixCrossSigningBootstrapCertificate")

  @@unique([deviceId, userId], map: "matrix_device_cross_signings_device_owner_key")
  @@index([userId, createdAt], map: "matrix_device_cross_signings_user_created_idx")
  @@map("matrix_device_cross_signings")
}

