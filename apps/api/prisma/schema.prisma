  cashier                CashierProfile                @relation(fields: [cashierUserId], references: [userId], onDelete: Restrict)
  invitation             CashierInvitation?            @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  previous               Assignment?                   @relation("AssignmentChain", fields: [previousAssignmentId], references: [id], onDelete: Restrict)
  next                   Assignment?                   @relation("AssignmentChain")
  createdByAdmin         User?                         @relation("AssignmentCreatedBy", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  conversation           Conversation?
  block                  Block?
  pendingReassignment    ReassignmentRequest?          @relation("ReassignmentPrevious")
  resultingReassignment  ReassignmentRequest?          @relation("ReassignmentResult")
  pendingEvidenceUploads PendingReportEvidenceUpload[]

  @@index([clientUserId, endedAt], map: "assignments_client_ended_idx")
  @@index([cashierUserId, endedAt], map: "assignments_cashier_ended_idx")
  @@index([startedAt], map: "assignments_started_at_idx")
  @@map("assignments")
}

model ReassignmentRequest {
  id                     String             @id @default(uuid()) @db.Uuid
  clientUserId           String             @map("client_user_id") @db.Uuid
  previousAssignmentId   String             @unique(map: "reassignment_requests_previous_assignment_key") @map("previous_assignment_id") @db.Uuid
  excludedCashierUserId  String             @map("excluded_cashier_user_id") @db.Uuid
  triggerBlockId         String?            @unique(map: "reassignment_requests_trigger_block_key") @map("trigger_block_id") @db.Uuid
  resultingAssignmentId  String?            @unique(map: "reassignment_requests_resulting_assignment_key") @map("resulting_assignment_id") @db.Uuid
  reason                 ReassignmentReason
  status                 ReassignmentStatus @default(PENDING)
  requestedAt            DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  lastAttemptAt          DateTime?          @map("last_attempt_at") @db.Timestamptz(6)
  attemptCount           Int                @default(0) @map("attempt_count")
  completedAt            DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancellationReasonCode String?            @map("cancellation_reason_code") @db.VarChar(64)

  client              ClientProfile  @relation(fields: [clientUserId], references: [userId], onDelete: Restrict)
  previousAssignment  Assignment     @relation("ReassignmentPrevious", fields: [previousAssignmentId], references: [id], onDelete: Restrict)
  excludedCashier     CashierProfile @relation("ReassignmentExcludedCashier", fields: [excludedCashierUserId], references: [userId], onDelete: Restrict)
  triggerBlock        Block?         @relation(fields: [triggerBlockId], references: [id], onDelete: Restrict)
  resultingAssignment Assignment?    @relation("ReassignmentResult", fields: [resultingAssignmentId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt], map: "reassignment_requests_status_requested_idx")
  @@index([clientUserId, status], map: "reassignment_requests_client_status_idx")
  @@map("reassignment_requests")
}

model Conversation {
  id           String             @id @default(uuid()) @db.Uuid
  assignmentId String             @unique(map: "conversations_assignment_key") @map("assignment_id") @db.Uuid
  status       ConversationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt     DateTime?          @map("closed_at") @db.Timestamptz(6)

  assignment               Assignment                    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  messages                 Message[]
  pendingAttachmentUploads PendingAttachmentUpload[]
  pendingEvidenceUploads   PendingReportEvidenceUpload[]
  oneTimePreKeyClaims      OneTimePreKeyClaim[]
  matrixKeyClaimRequests   MatrixKeyClaimRequest[]
  matrixToDeviceEvents     MatrixToDeviceEvent[]

  @@index([status, createdAt], map: "conversations_status_created_idx")
  @@map("conversations")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderUserId    String      @map("sender_user_id") @db.Uuid
  senderDeviceId  String      @map("sender_device_id") @db.Uuid
  clientMessageId String      @map("client_message_id") @db.Uuid
  serverSequence  BigInt      @unique(map: "messages_server_sequence_key") @default(autoincrement()) @map("server_sequence")
  kind            MessageKind
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '48 hours')")) @map("expires_at") @db.Timestamptz(6)

  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice  Device              @relation("MessageSenderDevice", fields: [senderDeviceId, senderUserId], references: [id, userId], onDelete: Restrict)
  envelopes     MessageEnvelope[]
  receipts      MessageReceipt[]
  attachment    Attachment?
  notifications InAppNotification[]

  @@unique([senderDeviceId, clientMessageId], map: "messages_sender_client_id_key")
  @@index([conversationId, createdAt], map: "messages_conversation_created_idx")
  @@index([expiresAt], map: "messages_expires_at_idx")
  @@map("messages")
}

model MessageEnvelope {
  id                String   @id @default(uuid()) @db.Uuid
  messageId         String   @map("message_id") @db.Uuid
  recipientDeviceId String   @map("recipient_device_id") @db.Uuid
  protocolVersion   String   @map("protocol_version") @db.VarChar(32)
  cipherSuite       String   @map("cipher_suite") @db.VarChar(64)
  ciphertext        Bytes
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientDevice Device  @relation("EnvelopeRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientDeviceId], map: "message_envelopes_message_device_key")
  @@index([recipientDeviceId, createdAt], map: "message_envelopes_device_created_idx")
  @@map("message_envelopes")
}

model MessageReceipt {
  messageId       String                @map("message_id") @db.Uuid
  recipientUserId String                @map("recipient_user_id") @db.Uuid
  status          MessageDeliveryStatus @default(SENT)
  deliveredAt     DateTime?             @map("delivered_at") @db.Timestamptz(6)
  readAt          DateTime?             @map("read_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@id([messageId, recipientUserId])
  @@index([recipientUserId, status, updatedAt], map: "message_receipts_recipient_status_idx")
  @@map("message_receipts")
}

model Attachment {
  id                 String                 @id @default(uuid()) @db.Uuid
  messageId          String                 @unique(map: "attachments_message_key") @map("message_id") @db.Uuid
  objectKey          String                 @unique(map: "attachments_object_key_key") @map("object_key") @db.VarChar(512)
  declaredMimeType   String                 @map("declared_mime_type") @db.VarChar(32)
  plaintextByteSize  Int                    @map("plaintext_byte_size")
  ciphertextByteSize Int                    @map("ciphertext_byte_size")
  ciphertextSha256   String                 @map("ciphertext_sha256") @db.Char(64)
  cipherSuite        String                 @map("cipher_suite") @db.VarChar(64)
  status             AttachmentUploadStatus @default(PENDING)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  purgeAttempts      Int                    @default(0) @map("purge_attempts")
  lastPurgeAttemptAt DateTime?              @map("last_purge_attempt_at") @db.Timestamptz(6)
  lastPurgeErrorCode String?                @map("last_purge_error_code") @db.VarChar(64)

  message Message @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([status], map: "attachments_status_idx")
  @@map("attachments")
}

model PendingAttachmentUpload {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  objectKey          String    @unique(map: "pending_attachment_uploads_object_key_key") @map("object_key") @db.VarChar(512)
  declaredMimeType   String    @map("declared_mime_type") @db.VarChar(32)
  plaintextByteSize  Int       @map("plaintext_byte_size")
  ciphertextByteSize Int       @map("ciphertext_byte_size")
  ciphertextSha256   String    @map("ciphertext_sha256") @db.Char(64)
  grantExpiresAt     DateTime  @map("grant_expires_at") @db.Timestamptz(6)
  purgeAttempts      Int       @default(0) @map("purge_attempts")
  lastPurgeAttemptAt DateTime? @map("last_purge_attempt_at") @db.Timestamptz(6)
  lastPurgeErrorCode String?   @map("last_purge_error_code") @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([grantExpiresAt], map: "pending_attachment_uploads_expires_idx")
  @@index([userId, conversationId], map: "pending_attachment_uploads_owner_conversation_idx")
  @@map("pending_attachment_uploads")
}

model Block {
  id            String         @id @default(uuid()) @db.Uuid
  clientUserId  String         @map("client_user_id") @db.Uuid
  cashierUserId String         @map("cashier_user_id") @db.Uuid
  assignmentId  String         @unique(map: "blocks_assignment_key") @map("assignment_id") @db.Uuid
  initiatedBy   BlockInitiator @map("initiated_by")
  reason        String         @db.VarChar(1000)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  client              ClientProfile        @relation(fields: [clientUserId], references: [userId], onDelete: Restrict)
  cashier             CashierProfile       @relation(fields: [cashierUserId], references: [userId], onDelete: Restrict)
  assignment          Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  report              Report?
  reassignmentRequest ReassignmentRequest?

  @@unique([clientUserId, cashierUserId, initiatedBy], map: "blocks_pair_initiator_key")
  @@index([clientUserId, initiatedBy], map: "blocks_client_initiator_idx")
  @@index([cashierUserId, initiatedBy], map: "blocks_cashier_initiator_idx")
  @@map("blocks")
}

model InvestigationKey {
  id          String    @id @default(uuid()) @db.Uuid
  version     Int       @unique
  algorithm   String    @db.VarChar(64)
  publicKey   Bytes     @map("public_key")
  fingerprint String    @unique @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt DateTime  @map("activated_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)

  evidence               ReportEvidence[]
  pendingEvidenceUploads PendingReportEvidenceUpload[]

  @@map("investigation_keys")
}

model Report {
  id                    String         @id @default(uuid()) @db.Uuid
  blockId               String         @unique(map: "reports_block_key") @map("block_id") @db.Uuid
  status                ReportStatus   @default(OPEN)
  reviewedByAdminUserId String?        @map("reviewed_by_admin_user_id") @db.Uuid
  reviewStartedAt       DateTime?      @map("review_started_at") @db.Timestamptz(6)
  outcome               ReportOutcome?
  resolutionSummary     String?        @map("resolution_summary") @db.VarChar(2000)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  closeRequestedAt      DateTime?      @map("close_requested_at") @db.Timestamptz(6)
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(6)
  evidencePurgedAt      DateTime?      @map("evidence_purged_at") @db.Timestamptz(6)
  subjectNotifiedAt     DateTime?      @map("subject_notified_at") @db.Timestamptz(6)

  block      Block             @relation(fields: [blockId], references: [id], onDelete: Restrict)
  reviewedBy User?             @relation("ReportReviewedBy", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  evidence   ReportEvidence?
  closureJob ReportClosureJob?

  @@index([status, createdAt], map: "reports_status_created_idx")
  @@map("reports")
}

model ReportClosureJob {
  reportId               String    @id @map("report_id") @db.Uuid
  requestedByAdminUserId String    @map("requested_by_admin_user_id") @db.Uuid
  evidenceObjectKey      String    @unique(map: "report_closure_jobs_evidence_object_key_key") @map("evidence_object_key") @db.VarChar(512)
  purgeNotBefore         DateTime  @map("purge_not_before") @db.Timestamptz(6)
  attempts               Int       @default(0)
  nextAttemptAt          DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseToken             String?   @map("lease_token") @db.Uuid
  leasedUntil            DateTime? @map("leased_until") @db.Timestamptz(6)
  lastAttemptAt          DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lastErrorCode          String?   @map("last_error_code") @db.VarChar(64)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  report           Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  requestedByAdmin User   @relation("ReportClosureRequestedBy", fields: [requestedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([nextAttemptAt, leasedUntil], map: "report_closure_jobs_due_idx")
  @@map("report_closure_jobs")
}

model ReportEvidence {
  id                    String   @id @default(uuid()) @db.Uuid
  reportId              String   @unique(map: "report_evidence_report_key") @map("report_id") @db.Uuid
  investigationKeyId    String   @map("investigation_key_id") @db.Uuid
  objectKey             String   @unique(map: "report_evidence_object_key_key") @map("object_key") @db.VarChar(512)
  ciphertextByteSize    BigInt   @map("ciphertext_byte_size")
  ciphertextSha256      String   @map("ciphertext_sha256") @db.Char(64)
  cipherSuite           String   @map("cipher_suite") @db.VarChar(64)
  manifestVersion       Int      @map("manifest_version")
  uploadAuthorizedUntil DateTime @map("upload_authorized_until") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report           Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  investigationKey InvestigationKey @relation(fields: [investigationKeyId], references: [id], onDelete: Restrict)

  @@map("report_evidence")
}

model PendingReportEvidenceUpload {
  id                 String    @id @default(uuid()) @db.Uuid
  clientUserId       String    @map("client_user_id") @db.Uuid
  assignmentId       String    @map("assignment_id") @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  investigationKeyId String    @map("investigation_key_id") @db.Uuid
  objectKey          String    @unique(map: "pending_report_evidence_uploads_object_key_key") @map("object_key") @db.VarChar(512)
  ciphertextByteSize Int       @map("ciphertext_byte_size")
  ciphertextSha256   String    @map("ciphertext_sha256") @db.Char(64)
  cipherSuite        String    @map("cipher_suite") @db.VarChar(64)
  manifestVersion    Int       @map("manifest_version")
  grantExpiresAt     DateTime  @map("grant_expires_at") @db.Timestamptz(6)
  purgeAttempts      Int       @default(0) @map("purge_attempts")
  lastPurgeAttemptAt DateTime? @map("last_purge_attempt_at") @db.Timestamptz(6)
  lastPurgeErrorCode String?   @map("last_purge_error_code") @db.VarChar(64)
