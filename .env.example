NODE_ENV=development
# Ruta opcional a otro archivo de entorno. Las variables del sistema prevalecen.
SINOCHAT_ENV_FILE=
WEB_ORIGIN=http://localhost:5173
# WebAuthn/passkeys: en desarrollo se deriva localhost. En producción el RP ID
# debe declararse y coincidir exactamente con el host de WEB_ORIGIN.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SinoChat
# Identidad publica estable del protocolo. En produccion es obligatoria y no
# debe cambiar tras registrar el primer dispositivo (normalmente el dominio).
MATRIX_SERVER_NAME=sinochat.invalid
API_PORT=3000
LEGAL_TIME_ZONE=America/Argentina/Buenos_Aires
VITE_API_URL=http://localhost:3000
VITE_CSRF_COOKIE_NAME=sinochat_csrf
DATABASE_URL=postgresql://sinochat:sinochat@localhost:5432/sinochat
# Opcional para CLI/CI. En producción debe pertenecer solo al job de migración.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
# Opcional en desarrollo. Es obligatorio y debe usar rediss:// en produccion.
REDIS_URL=redis://localhost:6379/0
# Debe ser unico si varias instalaciones comparten infraestructura Redis.
SOCKET_IO_REDIS_CHANNEL_PREFIX=sinochat:development:socket.io
# Namespace de contadores; debe ser único por instalación si se personaliza.
RATE_LIMIT_REDIS_PREFIX=sinochat:development:rate-limit
# Obligatorio en producción, aleatorio, >=32 bytes y distinto de otros secretos.
RATE_LIMIT_HMAC_SECRET=
TRUST_PROXY=none
SESSION_COOKIE_NAME=sinochat_session
CSRF_COOKIE_NAME=sinochat_csrf
# Sesiones comunes: hasta 30 días. Administrador: TTL absoluto de 1-24 horas
# e inactividad de 5-120 minutos, siempre menor que su TTL absoluto.
SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_PEPPER=
METADATA_HASH_SECRET=
INVITATION_ENCRYPTION_KEY=
INVITATION_ENCRYPTION_KEY_VERSION=1
# Objeto JSON opcional version:Base64 para descifrar códigos creados antes de
# una rotación. Nunca incluye la versión actual.
INVITATION_ENCRYPTION_PREVIOUS_KEYS=
ATTACHMENT_GRANT_SECRET=
EVIDENCE_UPLOAD_GRANT_SECRET=
DEVICE_BINDING_HMAC_SECRET=
# HMAC dedicado para tokens opacos de sync Matrix. En produccion debe ser
# diferente de todos los demas secretos; en desarrollo puede omitirse y se
# deriva temporalmente del secreto de vinculacion de dispositivos.
MATRIX_SYNC_TOKEN_SECRET=
# MinIO local: ejecutar `npm.cmd run local:storage:configure` para generar las
# cuatro credenciales sin mostrarlas. No reutilizarlas fuera de esta maquina.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=sinochat-ephemeral
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# MinIO local necesita direccionamiento path-style. Normalmente un S3 gestionado
# de produccion usa false; confirmar el valor exigido por el proveedor.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# `disabled`: el bucket nunca tuvo versionado. `purge-all`: el proveedor
# soporta ListObjectVersions/DeleteObjects y se eliminan todas las versiones.
OBJECT_STORAGE_VERSIONING_MODE=purge-all
RETENTION_WORKER_ENABLED=true
RETENTION_WORKER_INTERVAL_MS=30000
# Concilia vencimientos y reasignaciones pendientes. No puede desactivarse en
# produccion; el intervalo permitido es 5000-60000 ms.
SUBSCRIPTION_EXPIRY_WORKER_ENABLED=true
SUBSCRIPTION_EXPIRY_WORKER_INTERVAL_MS=10000
# Obligatorio en produccion. Reintenta cierres CLOSING con lease persistente.
REPORT_CLOSURE_WORKER_ENABLED=true
REPORT_CLOSURE_WORKER_INTERVAL_MS=15000
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Entradas operativas opcionales para `npm run terms:publish`.
TERMS_DOCUMENT_FILE=
TERMS_DOCUMENT_VERSION=
TERMS_DOCUMENT_TYPE=
TERMS_DOCUMENT_EFFECTIVE_AT=
TERMS_DOCUMENT_EXPECTED_SHA256=

# Solo material PÚBLICO DER SPKI para `npm run investigation-key:register`.
INVESTIGATION_PUBLIC_KEY_BASE64=
INVESTIGATION_KEY_ALGORITHM=
INVESTIGATION_KEY_FINGERPRINT=
INVESTIGATION_KEY_VERSION=

# En producción, WEB_ORIGIN debe usar HTTPS, los secretos deben estar completos
# REDIS_URL debe usar rediss:// y las cookies deben llamarse
# __Host-sinochat_session y __Host-sinochat_csrf. La compilacion web debe usar
# VITE_CSRF_COOKIE_NAME=__Host-sinochat_csrf y servir /api en el mismo origen.
